{
  "name": "parser-stream-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Steven Tsao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steventsao/parser-stream.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.workers.json",
    "test": "vitest run",
    "cli": "tsx apps/cli/src/bin.ts",
    "deploy": "wrangler deploy --config apps/worker/wrangler.toml",
    "sample-pdf": "tsx scripts/sample-pdf.ts",
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115",
    "@parser-stream/app": "workspace:*",
    "@parser-stream/gemini": "workspace:*",
    "@parser-stream/http": "workspace:*",
    "@parser-stream/markdown": "workspace:*",
    "@parser-stream/node": "workspace:*",
    "@parser-stream/openai-compatible": "workspace:*",
    "@parser-stream/parsebench": "workspace:*",
    "@parser-stream/testkit": "workspace:*",
    "@parser-stream/workers": "workspace:*",
    "@types/node": "^22",
    "effect": "4.0.0-rc.115",
    "parser-stream": "workspace:*",
    "pdf-lib": "^1.17.1",
    "tsx": "^4",
    "typescript": "^5.9",
    "vitest": "^5.0.1",
    "wrangler": "^4"
  }
}
