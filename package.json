{
  "name": "parser-stream",
  "version": "0.1.0",
  "description": "Stream documents into clean, sanitized, semantic HTML. Bring your own key, or bring your own parser. Built with Effect.",
  "type": "module",
  "license": "MIT",
  "author": "Steven Tsao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steventsao/parser-stream.git"
  },
  "keywords": [
    "pdf",
    "html",
    "parser",
    "streaming",
    "sse",
    "effect",
    "gemini",
    "byok"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "parser-stream": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./parsers": {
      "types": "./dist/parsers/index.d.ts",
      "default": "./dist/parsers/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "default": "./dist/app/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./workers/sanitizer": {
      "types": "./dist/workers/Sanitizer.d.ts",
      "default": "./dist/workers/Sanitizer.js"
    },
    "./workers/session-store": {
      "types": "./dist/workers/SessionStore.d.ts",
      "default": "./dist/workers/SessionStore.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.workers.json",
    "test": "vitest run",
    "cli": "tsx src/bin.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115",
    "html-rewriter-wasm": "^0.4.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@effect/vitest": "4.0.0-rc.115",
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.9",
    "vitest": "^5.0.1",
    "wrangler": "^4"
  }
}
