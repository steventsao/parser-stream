# Which plugin converts the document:
#   gemini-parsebench (default) | gemini-html | openai | http
# PARSER=gemini-parsebench

# Key for the Gemini plugins. Optional: an upload can bring its own key.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview

# PARSER=openai — any OpenAI-compatible server (vLLM, Ollama, LM Studio).
# These servers read images, not PDFs.
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=qwen3-vl-8b
# OPENAI_API_KEY=
# PARSER_MODE=markdown

# PARSER=http — your own endpoint, in any language (see the README).
# PARSER_URL=http://127.0.0.1:8000/parse
# PARSER_TOKEN=
