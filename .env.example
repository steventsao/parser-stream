# Which parser to use: parsebench (default) | gemini-html | http
# PARSER=parsebench

# Key for the Gemini parsers. Optional: an upload can bring its own key.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview

# Or bring your own parser behind one HTTP endpoint (see README).
# PARSER=http
# PARSER_URL=http://127.0.0.1:8000/parse
# PARSER_TOKEN=
