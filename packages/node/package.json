{
  "name": "@parser-stream/node",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Steven Tsao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steventsao/parser-stream.git",
    "directory": "packages/node"
  },
  "description": "Node adapters: the lol-html sanitizer and an HTTP server for the app routes.",
  "exports": {
    ".": "./src/index.ts",
    "./Sanitizer": "./src/Sanitizer.ts",
    "./Server": "./src/Server.ts"
  },
  "dependencies": {
    "effect": "4.0.0-rc.115",
    "parser-stream": "workspace:*",
    "@parser-stream/app": "workspace:*",
    "html-rewriter-wasm": "^0.4.1",
    "@effect/platform-node": "4.0.0-rc.115"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./Sanitizer": {
        "types": "./dist/Sanitizer.d.ts",
        "default": "./dist/Sanitizer.js"
      },
      "./Server": {
        "types": "./dist/Server.d.ts",
        "default": "./dist/Server.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  }
}
