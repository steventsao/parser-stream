{
  "name": "parser-stream",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Steven Tsao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steventsao/parser-stream.git",
    "directory": "packages/core"
  },
  "description": "Stream a document into sanitized HTML blocks. The HtmlStream port and the streaming DOM engine.",
  "exports": {
    ".": "./src/index.ts",
    "./Converter": "./src/Converter.ts",
    "./HtmlStream": "./src/HtmlStream.ts",
    "./HtmlHandlers": "./src/HtmlHandlers.ts",
    "./Credential": "./src/Credential.ts",
    "./Sanitizer": "./src/Sanitizer.ts",
    "./Source": "./src/Source.ts",
    "./Splitter": "./src/Splitter.ts",
    "./splitters/Pdf": "./src/splitters/Pdf.ts",
    "./domain/Html": "./src/domain/Html.ts",
    "./domain/Document": "./src/domain/Document.ts",
    "./domain/Events": "./src/domain/Events.ts"
  },
  "dependencies": {
    "effect": "4.0.0-rc.115",
    "pdf-lib": "^1.17.1"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./Converter": {
        "types": "./dist/Converter.d.ts",
        "default": "./dist/Converter.js"
      },
      "./HtmlStream": {
        "types": "./dist/HtmlStream.d.ts",
        "default": "./dist/HtmlStream.js"
      },
      "./HtmlHandlers": {
        "types": "./dist/HtmlHandlers.d.ts",
        "default": "./dist/HtmlHandlers.js"
      },
      "./Credential": {
        "types": "./dist/Credential.d.ts",
        "default": "./dist/Credential.js"
      },
      "./Sanitizer": {
        "types": "./dist/Sanitizer.d.ts",
        "default": "./dist/Sanitizer.js"
      },
      "./Source": {
        "types": "./dist/Source.d.ts",
        "default": "./dist/Source.js"
      },
      "./Splitter": {
        "types": "./dist/Splitter.d.ts",
        "default": "./dist/Splitter.js"
      },
      "./splitters/Pdf": {
        "types": "./dist/splitters/Pdf.d.ts",
        "default": "./dist/splitters/Pdf.js"
      },
      "./domain/Html": {
        "types": "./dist/domain/Html.d.ts",
        "default": "./dist/domain/Html.js"
      },
      "./domain/Document": {
        "types": "./dist/domain/Document.d.ts",
        "default": "./dist/domain/Document.js"
      },
      "./domain/Events": {
        "types": "./dist/domain/Events.d.ts",
        "default": "./dist/domain/Events.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  }
}
