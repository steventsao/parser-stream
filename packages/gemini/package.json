{
  "name": "@parser-stream/gemini",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Steven Tsao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steventsao/parser-stream.git",
    "directory": "packages/gemini"
  },
  "description": "Gemini plugins: the Flash + ParseBench layout parser, a direct-HTML parser, and the transport.",
  "exports": {
    ".": "./src/index.ts",
    "./ParseBench": "./src/ParseBench.ts",
    "./Html": "./src/Html.ts",
    "./Transport": "./src/Transport.ts"
  },
  "dependencies": {
    "effect": "4.0.0-rc.115",
    "parser-stream": "workspace:*",
    "@parser-stream/parsebench": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./ParseBench": {
        "types": "./dist/ParseBench.d.ts",
        "default": "./dist/ParseBench.js"
      },
      "./Html": {
        "types": "./dist/Html.d.ts",
        "default": "./dist/Html.js"
      },
      "./Transport": {
        "types": "./dist/Transport.d.ts",
        "default": "./dist/Transport.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  }
}
